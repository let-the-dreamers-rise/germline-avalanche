# Never commit the real .env. The deployer key is the only secret here.
DEPLOYER_KEY=0xyour_private_key_here

# Optional overrides; sensible defaults are in hardhat.config.js
ZEROG_RPC=https://evmrpc.0g.ai
GALILEO_RPC=https://evmrpc-testnet.0g.ai

# 0G Storage indexer, used by the engine to publish genomes and transcripts
ZEROG_INDEXER=https://indexer-storage-turbo.0g.ai

# 0G Compute endpoint for the LLM mutation operator (optional)
ZEROG_COMPUTE_URL=
ZEROG_COMPUTE_KEY=

# 0G Compute Router, for trials scored by a model judge.
# Get a key at pc.0g.ai and deposit 0G. Without it, compute-check.js still
# proves the router is reachable, because the model list needs no key.
ZEROG_COMPUTE_URL=https://router-api.0g.ai/v1
ZEROG_COMPUTE_KEY=
ZEROG_COMPUTE_MODEL=0gm-1.0-35b-a3b

# 0G Storage upload is an on-chain submission, so it stays opt-in.
ZEROG_STORAGE_UPLOAD=0

# Where payloads live. The chain carries a keccak root computed from bytes we
# hold, and every read is checked against it, so the store does not have to be
# trusted -- which is why a plain directory or a static HTTP host is a complete
# answer and not a compromise.
#
#   fs    files under GERMLINE_STORE_DIR (default, no dependencies)
#   http  read from GERMLINE_STORE_URL; write too, if PUT is available
#   0g    delegate to lib/storage.js and 0G Storage
GERMLINE_STORE=fs
GERMLINE_STORE_DIR=
GERMLINE_STORE_URL=
GERMLINE_STORE_PUT_URL=
GERMLINE_STORE_TIMEOUT_MS=10000
